<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BaseBullet">
    <defName>ZYS_Bullet_Type05Revolver</defName>
    <label>revolver bullet</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>3</damageAmountBase>
      <stoppingPower>1</stoppingPower>
      <speed>25</speed>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>Zys_Type05_Revolver</defName>
    <label>Type 05 Police Revolver</label>
    <description>A revolver designed for police use that is so difficult to shoot someone with it. It is said the most effective way to use is to throw it.\n\nAlso known as ZLS-05.</description>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Weapons/Type05revolver</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.6</drawSize>
    </graphicData>
    <uiIconScale>1.2</uiIconScale>
    <soundInteract>Interact_Revolver</soundInteract>
    <statBases>
      <WorkToMake>3200</WorkToMake>
      <Mass>1.0</Mass>
      <AccuracyTouch>0.85</AccuracyTouch>
      <AccuracyShort>0.80</AccuracyShort>
      <AccuracyMedium>0.30</AccuracyMedium>
      <AccuracyLong>0.20</AccuracyLong>
      <RangedWeapon_Cooldown>1.3</RangedWeapon_Cooldown>
    </statBases>
    <weaponTags>
      <li>SimpleGun</li>
      <li>Revolver</li>
    </weaponTags>
    <weaponClasses>
      <li>RangedLight</li>
    </weaponClasses>
    <costList>
      <Steel>20</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <skillRequirements>
        <Crafting>3</Crafting>
      </skillRequirements>
      <displayPriority>400</displayPriority>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>ZYS_Bullet_Type05Revolver</defaultProjectile>
        <warmupTime>0.2</warmupTime>
        <range>20.9</range>
        <soundCast>Shot_Revolver</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>8</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>1.8</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>1.8</cooldownTime>
      </li>
    </tools>
  </ThingDef>

  <ThingDef ParentName="BaseMeleeWeapon_Blunt_Quality">
    <defName>Zys_Type05_Revolver_Flail</defName>
    <label>Type 05 Police Revolver (Flail)</label>
    <description>It is said that the most effective use of this pistol is to use it as a flail...</description>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Weapons/Type05revolverFlail</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.8</drawSize>
    </graphicData>
    <uiIconScale>1.2</uiIconScale>
    <techLevel>Industrial</techLevel>
    <costStuffCount>50</costStuffCount>
    <statBases>
      <WorkToMake>400</WorkToMake>
      <Mass>1.25</Mass>
    </statBases>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <costList>
      <Zys_Type05_Revolver>1</Zys_Type05_Revolver>
      <Steel>2</Steel>
      <WoodLog>1</WoodLog>
    </costList>
    <recipeMaker>
      <researchPrerequisite>Gunsmithing</researchPrerequisite>
      <recipeUsers Inherit="False">
        <li>TableMachining</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>3</Crafting>
      </skillRequirements>
      <displayPriority>400</displayPriority>
    </recipeMaker>
    <weaponTags>
      <li>MedievalMeleeDecent</li>
    </weaponTags>
    <weaponClasses>
      <li>Melee</li>
    </weaponClasses>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>18</power>
        <cooldownTime>2.2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>15</power>
        <cooldownTime>2.2</cooldownTime>
      </li>
      <li>
        <label>handle</label>
        <capacities>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2.2</cooldownTime>
      </li>
    </tools>
  </ThingDef>
</Defs>
